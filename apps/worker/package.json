{
  "name": "@nodetunnel/worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "NodeTunnel 中心服务：信令房间、中继转发与管理 API",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "wrangler d1 migrations apply nodetunnel --remote",
    "db:migrate:local": "wrangler d1 migrations apply nodetunnel --local"
  },
  "dependencies": {
    "@nodetunnel/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20250204.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0",
    "wrangler": "^4.130.0"
  }
}
