{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nodetunnel",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  // 与上游 easytier-js/cloudflare 的 wrangler.jsonc 保持一致：只需 nodejs_compat。
  //
  // 曾尝试加入 JSPI 相关标志，但 workerd 并不存在名为 jspi /
  // experimental_wasm_jspi 的 compatibility flag（两者都会导致
  // 「No such compatibility flag」而无法启动）。上游 Cloudflare 适配层
  // 不使用 JSPI 调度，浏览器 profile 才需要 WebAssembly.Suspending。
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],
  "vars": {
    "NODETUNNEL_VERSION": "0.1.0"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EASYTIER_RELAY",
        "class_name": "EasyTierRelayObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EasyTierRelayObject"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nodetunnel",
      "database_id": "REPLACE_WITH_REAL_D1_ID",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
