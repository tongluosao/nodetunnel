{
  "name": "@easytier/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "EasyTier 共享 WebAssembly 运行时（同步自上游 easytier-js，见 UPSTREAM.md）",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./adapter": {
      "types": "./src/adapter.ts",
      "import": "./src/adapter.ts"
    }
  },
  "scripts": {
    "build": "echo \"@easytier/runtime 直接以 TS 源码被使用方编译，无需构建\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "binaryen": "^131.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
