{
  "name": "@easytier/cloudflare",
  "version": "0.1.0",
  "private": true,
  "description": "在 Cloudflare Durable Object 中运行 EasyTier 中继（同步自上游 easytier-js，见 UPSTREAM.md）",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "echo \"@easytier/cloudflare 直接以 TS 源码被 worker 打包，无需构建\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@easytier/runtime": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250204.0",
    "@types/node": "^22.18.1",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
