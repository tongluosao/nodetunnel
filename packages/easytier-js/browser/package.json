{
  "name": "@easytier/browser",
  "version": "0.1.0",
  "private": true,
  "description": "在浏览器中运行 EasyTier 客户端（同步自上游 easytier-js，见 UPSTREAM.md）",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "echo \"@easytier/browser 直接以 TS 源码被 portal 打包，无需构建\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@easytier/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
